{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/format-after-edit.cjs",
            "commandWindows": "node .codex/hooks/format-after-edit.cjs",
            "timeout": 30,
            "statusMessage": "Comprobando formato de los archivos editados"
          }
        ]
      }
    ]
  }
}
