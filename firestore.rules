rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function propietario(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function textos(a) {
      return a is list && a.size() <= 10
        && (a.size() <= 0 || a[0] is string)
        && (a.size() <= 1 || a[1] is string)
        && (a.size() <= 2 || a[2] is string)
        && (a.size() <= 3 || a[3] is string)
        && (a.size() <= 4 || a[4] is string)
        && (a.size() <= 5 || a[5] is string)
        && (a.size() <= 6 || a[6] is string)
        && (a.size() <= 7 || a[7] is string)
        && (a.size() <= 8 || a[8] is string)
        && (a.size() <= 9 || a[9] is string);
    }
    function nuevos(d) {
      let fecha = d.get('vistaEn', null);
      let minutos = d.get('duracionMin', null);
      return (fecha == null || (fecha is timestamp && d.estado == 'vista'))
        && textos(d.get('generos', [])) && textos(d.get('directores', []))
        && (minutos == null || (minutos is int && minutos >= 1 && minutos <= 1000))
        && (d.tipo != 'tv' || (minutos == null && d.get('directores', []).size() == 0));
    }
    function fechaValida(d, old) {
      let fecha = d.get('vistaEn', null);
      let previa = old.get('vistaEn', null);
      return d.estado != 'vista' ? fecha == null
        : old.estado != 'vista' ? fecha == request.time
        : previa != null ? fecha == previa
        : fecha == null || (fecha == old.actualizadoEn
          && d.diff(old).affectedKeys().hasOnly(['vistaEn','actualizadoEn']));
    }
    function metadatosSinSobrescribir(d, old) {
      return (!('generos' in old) || d.get('generos', null) == old.generos)
        && (!('duracionMin' in old) || d.get('duracionMin', -1) == old.duracionMin)
        && (!('directores' in old) || d.get('directores', null) == old.directores);
    }
    function valido(d, itemId) {
      return d.keys().hasAll(['tmdbId','tipo','titulo','anio','posterPath','estado','calificacionPersonal','comentario','agregadoEn','actualizadoEn'])
        && d.keys().hasOnly(['tmdbId','tipo','titulo','anio','posterPath','estado','calificacionPersonal','comentario','agregadoEn','actualizadoEn','vistaEn','generos','duracionMin','directores'])
        && d.tmdbId is int && d.tmdbId > 0
        && d.tipo in ['movie','tv']
        && itemId == d.tipo + '_' + string(d.tmdbId)
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 200
        && d.titulo.matches('[\\s\\S]*\\S[\\s\\S]*')
        && d.anio is string && (d.posterPath == null || d.posterPath is string)
        && d.estado in ['por_ver','viendo','vista']
        && d.comentario is string && d.comentario.size() <= 500
        && (d.calificacionPersonal == null || (d.calificacionPersonal is int && d.calificacionPersonal >= 1 && d.calificacionPersonal <= 5))
        && (d.estado == 'vista' || d.calificacionPersonal == null)
        && d.agregadoEn is timestamp && d.actualizadoEn is timestamp && nuevos(d);
    }
    match /usuarios/{uid}/mi_lista/{itemId} {
      allow read: if propietario(uid);
      allow create: if propietario(uid) && valido(request.resource.data, itemId)
        && request.resource.data.keys().hasAll(['vistaEn','generos','duracionMin','directores'])
        && request.resource.data.vistaEn == null
        && request.resource.data.estado == 'por_ver'
        && request.resource.data.calificacionPersonal == null
        && request.resource.data.comentario == ''
        && request.resource.data.agregadoEn == request.time
        && request.resource.data.actualizadoEn == request.time;
      allow update: if propietario(uid) && valido(request.resource.data, itemId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','calificacionPersonal','comentario','actualizadoEn','vistaEn','generos','duracionMin','directores'])
        && fechaValida(request.resource.data, resource.data)
        && metadatosSinSobrescribir(request.resource.data, resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['generos','duracionMin','directores'])
          || (resource.data.estado == 'vista' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['generos','duracionMin','directores','actualizadoEn'])))
        && request.resource.data.agregadoEn == resource.data.agregadoEn
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if propietario(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
